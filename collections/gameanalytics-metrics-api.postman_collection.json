      "item": [
        {
          "id": "1ca81cc4-6c58-4a01-b668-7df0d70a3b78",
          "name": "Query an aggregated gameplay metric.",
          "request": {
            "name": "Query an aggregated gameplay metric.",
            "description": {
              "content": "Returns aggregated metric data (for example `dau`, `mau`, `retention_retro`, `arpu`, `arppu`, `session_length`, `revenue`, `ad_revenue`) as JSON. Authenticated with the `X-API-Key` header. The body specifies an ISO-8601 `interval`, a `granularity`, an optional `game` id, and a `query` object of type `group`, `split`, or `timeseries`.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "metrics",
                "v1",
                "metrics",
                ":metric"
              ],
              "host": [
                "metrics",
                "gameanalytics",
                "com"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "metric",
                  "description": "(Required) The metric to query (e.g. dau, mau, retention_retro, arpu, arppu, session_length)."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interval\": \"<string>\",\n  \"granularity\": \"<string>\",\n  \"query\": {\n    \"type\": \"<string>\",\n    \"dimensions\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"limit\": \"<integer>\"\n  },\n  \"game\": \"<integer>\",\n  \"days_since_install\": [\n    \"<integer>\",\n    \"<integer>\"\n  ],\n  \"filter\": {\n    \"key_0\": 8825,\n    \"key_1\": 924\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
